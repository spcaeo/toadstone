# Toadstone configuration. Copy to .env and edit.
#
#   cp .env.example .env
#
# Every value here has a working default except SECRET_KEY, which you should
# set before anyone else can reach this install.


# ── Where it listens ────────────────────────────────────────────────────────

# 127.0.0.1 = this machine only. 0.0.0.0 = anything that can route to you,
# which means put TLS and a reverse proxy in front of it first.
HOST_BINDING=127.0.0.1

# The port on the host. Inside the container it is always 5000.
#
# macOS note: port 5000 belongs to AirPlay Receiver, which answers every
# request with "403 AirTunes" — the app looks like it started and nothing
# works. Pick another port here, or turn AirPlay Receiver off in
# System Settings → General → AirDrop & Handoff.
EXTERNAL_PORT=5000

# Running without Docker (python main.py), this is the port instead.
# The --port flag beats it.
# PORT=5057


# ── Security ────────────────────────────────────────────────────────────────

# Signs session cookies and derives the key that encrypts stored Google
# tokens. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Unset, the app warns and uses an ephemeral random key: sessions die on
# restart, and connecting a Google account is refused outright rather than
# stored unencrypted. Changing it later makes already-stored tokens
# unreadable, by design.
# SECRET_KEY=

# "true" DISABLES ALL AUTHENTICATION and grants every visitor admin.
# Correct on a laptop. Wrong on anything reachable.
LOCAL_MODE=false

# "true" stops new people registering.
REGISTRATION_DISABLED=false

# "true" lets anyone log in as any username with no password; the username
# only separates sessions. For development. The name is the warning.
DANGEROUSLY_SKIP_AUTH=false

# "true" caps each user at 1.5GB of crawl data and stops their crawl there.
DEMO_MODE=false


# ── Google: Search Console, Analytics, CrUX ─────────────────────────────────

# Set these two and Settings → Google grows a "Connect Google" button. Each
# person then connects their own account in one click and never sees these
# values.
#
# A distributed project cannot ship a shared OAuth client, because its secret
# would be in public — so each installation registers its own once. Five
# minutes:
#   1. console.cloud.google.com → pick or create a project
#   2. APIs & Services → Library → enable "Google Search Console API"
#      and "Google Analytics Data API"
#   3. APIs & Services → OAuth consent screen → External, add yourself as a
#      test user (no Google review needed for your own use)
#   4. APIs & Services → Credentials → OAuth client ID → "Web application"
#   5. Add the redirect URI that Settings → Google prints for this install,
#      exactly as printed, port and all — do not type it from memory
# Full walkthrough: docs/google.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# A Chrome UX Report key, which is free and read-only. Set it once here and
# every crawl gets real-user Core Web Vitals without each person pasting the
# same string into their own settings. A per-user key in Settings wins over
# this one.
#   console.cloud.google.com → enable "Chrome UX Report API" → create an
#   API key → restrict it to that one API
# GOOGLE_API_KEY=


# ── The optional agent layer ────────────────────────────────────────────────

# The Claude CLI is a native binary for the host OS, so it cannot run inside
# the Linux container. Rather than bake a long-lived credential into the
# image, run tools/claude_bridge.py on the host and point the container at
# it. Leave the token empty to keep the agent layer off, which is the
# default: a crawler that silently spends money, or silently sends a client's
# page text to a third party, has broken somebody's trust.
# CLAUDE_BRIDGE_URL=http://host.docker.internal:14898/ask
# CLAUDE_BRIDGE_TOKEN=

# The other agent mode talks to Anthropic directly instead of through the
# bridge. Also off unless set. See docs/agents.md.
# ANTHROPIC_API_KEY=


# ── Email, only needed for account verification ─────────────────────────────

# Unset, nobody is emailed and registration works without verification.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=Toadstone

# Where verification links should point. Set it if the app is behind a proxy
# or on a domain, so the links in those emails are not localhost.
# MAIN_APP_URL=
